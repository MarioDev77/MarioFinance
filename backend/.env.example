# PostgreSQL do backend (somente no servidor)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mariofin?schema=public"

# Conta criada pelo seed
ADMIN_EMAIL="seuemail@exemplo.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# OBRIGATÓRIO: segredo usado para assinar o cookie da sessão.
# Use uma chave aleatória com pelo menos 32 caracteres.
SESSION_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Origem EXATA do frontend, sem barra no final.
# Em produção, use por exemplo: https://seu-frontend.vercel.app
ALLOWED_ORIGINS="http://localhost:3000"
NODE_ENV="development"
